.container {
    padding-bottom: 48rpx;
}

.card-title {
    font-size: 30rpx;
    font-weight: 600;
    color: var(--text-main);
}

/* ============ 月历导航 ============ */
.month-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.nav-btn {
    width: 72rpx;
    height: 72rpx;
    border-radius: 20rpx;
    background: var(--chip-bg);
    color: var(--accent);
    font-size: 44rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}

.nav-btn-disabled {
    color: var(--text-faint);
    opacity: 0.4;
}

.month-title {
    font-size: 32rpx;
    font-weight: 700;
    color: var(--text-main);
}

/* ============ 月历热力格 ============ */
.week-header {
    display: flex;
    margin-bottom: 8rpx;
}

.week-day {
    width: 91rpx;
    text-align: center;
    font-size: 22rpx;
    color: var(--text-muted);
}

.month-grid {
    display: flex;
    flex-wrap: wrap;
}

.m-cell {
    width: 87rpx;
    height: 96rpx;
    margin: 2rpx;
    border-radius: 14rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4rpx;
    background: var(--heat-empty);
}

.m-empty {
    background: transparent;
}

.m-future {
    opacity: 0.35;
}

.m-day {
    font-size: 28rpx;
    font-weight: 600;
    color: var(--text-sub);
    line-height: 1;
}

.m-min {
    font-size: 18rpx;
    color: var(--text-muted);
    line-height: 1;
}

/* 热力等级配色（与图例一致） */
.m-l1 { background: #b2f2bb; }
.m-l2 { background: #69db7c; }
.m-l3 { background: #2f9e44; }
.m-l4 { background: #1e6e33; }

/* 深绿底上换成浅色文字保证对比度 */
.m-l3 .m-day,
.m-l4 .m-day {
    color: #ffffff;
}

.m-l3 .m-min,
.m-l4 .m-min {
    color: rgba(255, 255, 255, 0.85);
}

/* ============ 本月概览 ============ */
.m-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.m-stat {
    flex: 1 1 280rpx;
    background: var(--track-bg);
    border-radius: 16rpx;
    padding: 24rpx 16rpx;
    text-align: center;
}

.m-stat-value {
    font-size: 30rpx;
    font-weight: 700;
    color: var(--accent);
}

.m-stat-label {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: var(--text-muted);
}

/* ============ 图例 ============ */
.legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 20rpx;
    gap: 6rpx;
}

.legend-cell {
    width: 24rpx;
    height: 24rpx;
    border-radius: 6rpx;
}

.legend-text {
    font-size: 22rpx;
    color: var(--text-muted);
    margin: 0 6rpx;
}

.cell.l0 { background: var(--heat-empty); }
.cell.l1 { background: #b2f2bb; }
.cell.l2 { background: #69db7c; }
.cell.l3 { background: #2f9e44; }
.cell.l4 { background: #1e6e33; }

/* ============ 状态 ============ */
.state-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 0;
}

.loading-dot {
    width: 32rpx;
    height: 32rpx;
    border-radius: 50%;
    border: 6rpx solid var(--spin-track);
    border-top-color: var(--accent);
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.state-text {
    margin-top: 16rpx;
    font-size: 26rpx;
    color: var(--text-muted);
}

.error-text {
    color: var(--error);
}

.retry-btn {
    margin-top: 24rpx;
    padding: 0 48rpx;
    height: 72rpx;
}

/* ============ 明细 ============ */
.detail-card {
    border: 2rpx solid var(--accent);
}

.detail-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.detail-total {
    font-size: 24rpx;
    color: var(--text-muted);
    margin-bottom: 16rpx;
}

.detail-close {
    font-size: 26rpx;
    color: var(--accent);
    padding: 4rpx 8rpx;
}

.session-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx 0;
    border-bottom: 1rpx solid var(--border);
}

.session-item:last-child {
    border-bottom: none;
}

.session-left {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
    margin-right: 16rpx;
    flex: 1;
    min-width: 0;
}

.session-note {
    font-size: 24rpx;
    color: var(--text-muted);
    line-height: 1.5;
}

/* 未完成原因：橙色弱强调，与普通描述区分 */
.session-abort {
    color: #e8590c;
}

.session-time {
    font-size: 26rpx;
    color: var(--text-sub);
    font-variant-numeric: tabular-nums;
}

.session-right {
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.session-dur {
    font-size: 26rpx;
    font-weight: 600;
    color: var(--text-main);
}

.session-status {
    font-size: 22rpx;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
}

.status-done {
    color: var(--ok-text);
    background: var(--ok-bg);
}

.status-abort {
    color: var(--warn-text);
    background: var(--warn-bg);
}

.session-empty {
    padding: 24rpx 0;
    text-align: center;
    font-size: 26rpx;
    color: var(--text-faint);
}

/* ============ 空状态 ============ */
.empty-card {
    text-align: center;
    padding: 48rpx 32rpx;
}

.empty-icon {
    font-size: 64rpx;
}

.empty-text {
    margin-top: 16rpx;
    font-size: 26rpx;
    color: var(--text-muted);
    line-height: 1.6;
}
